# JavaScript (Brotli y Gzip)
  /build/*.js
    Content-Type: application/javascript
    Content-Encoding: br

  /build/*.js.gz
    Content-Type: application/javascript
    Content-Encoding: gzip

# WebAssembly (Brotli y Gzip)
  /build/*.wasm
    Content-Type: application/wasm
    Content-Encoding: br

  /build/*.wasm.gz
    Content-Type: application/wasm
    Content-Encoding: gzip

# Data files (Brotli y Gzip)
  /build/*.data
    Content-Type: application/octet-stream
    Content-Encoding: br

  /build/*.data.gz
    Content-Type: application/octet-stream
    Content-Encoding: gzip

# Unity loader (normal JS, no compresión extra aquí)
  /build/*.loader.js
    Content-Type: application/javascript
