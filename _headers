/Build/*.js
  Content-Type: application/javascript
  Cache-Control: public, max-age=31536000, immutable

/Build/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

/Build/*.data
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable

/Build/*.symbols.json
  Content-Type: application/json
  Cache-Control: public, max-age=31536000, immutable
